rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerEmail() {
      return signedIn() && request.auth.token.email == "vits0007@gmail.com";
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return ownerEmail() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc(request.auth.uid).data.role == "admin" && userDoc(request.auth.uid).data.accessStatus != "blocked");
    }

    // Одобренный (и не заблокированный) пользователь — для доступа к общему каталогу
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc(request.auth.uid).data.accessStatus == "approved";
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /user_db/{uid}/{document=**} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    match /server_db/{document=**} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_logs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /security_events/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_usage/{uid}/{document=**} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /drafts/{uid}/{document=**} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    match /estimates/{uid}/{document=**} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    /* Бан в чате (модерация): документ существует — человек НЕ может писать ни в общий
       чат, ни в личку. Ставит и снимает ТОЛЬКО админ; читают все одобренные, чтобы
       клиент честно показал «доступ к чату ограничен» вместо молчаливой ошибки. */
    function chatBanned() {
      return signedIn() && exists(/databases/$(database)/documents/chat_bans/$(request.auth.uid));
    }
    match /chat_bans/{uid} {
      allow read: if isApproved() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /* Жалобы на сообщения: «клиенты жалуются, а админ решает». Пишет любой одобренный
       (только от своего имени), читает и закрывает — только админ. */
    match /chat_reports/{repId} {
      allow read: if isAdmin();
      allow create: if (isApproved() || isAdmin())
        && request.resource.data.by == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* Общий чат замечаний (кнопка 💬 внутри приложения).
       Читают ВСЕ одобренные пользователи — в этом и смысл «общего» чата: видно
       переписку и сообщения других тестировщиков. Тот же предикат isApproved(),
       что и у общего каталога server_db — отдельной семантики доступа не заводим.
       Писать — только от своего имени (uid == request.auth.uid) и в разумных
       границах длины; правки задним числом запрещены совсем (чат — журнал, а не
       документ), удаление — автор своего сообщения или админ (модерация). */
    match /chat_messages/{msgId} {
      allow read: if isApproved() || isAdmin();
      allow create: if (isApproved() || isAdmin())
        && !chatBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.ts is number;
      /* Правка СВОЕГО сообщения (просьба пользователя «иметь возможность редактировать
         собственное сообщение»): автор меняет только текст, подменить автора/время
         (uid/ts) нельзя — история остаётся честной, а чужое сообщение не тронуть. */
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.ts == resource.data.ts
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    /* Кто в сети: один документ на пользователя, который он же и обновляет
       «сердцебиением» (раз в 2 минуты, пока приложение открыто). Читают все
       одобренные — из этого и складывается список людей с зелёной точкой. */
    match /chat_presence/{uid} {
      allow read: if isApproved() || isAdmin();
      allow create, update: if isSelf(uid) && (isApproved() || isAdmin()) && request.resource.data.at is number;
      allow delete: if isSelf(uid) || isAdmin();
    }

    /* ЛИЧНЫЕ сообщения (просьба «перейти с публичного в личную переписку»): видят
       ТОЛЬКО двое участников (uids). Админ здесь НЕ читает — это личка, а не общий
       журнал; модерация остаётся только у публичного чата. Автор правит свой текст,
       получатель может лишь отметить прочтение (seen) — текст при этом не меняется. */
    match /chat_dm/{msgId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if (isApproved() || isAdmin())
        && !chatBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.to in request.resource.data.uids
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.ts is number;
      allow update: if signedIn() && (
        (resource.data.from == request.auth.uid
          && request.resource.data.from == resource.data.from
          && request.resource.data.uids == resource.data.uids
          && request.resource.data.ts == resource.data.ts
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000)
        || (resource.data.to == request.auth.uid
          && request.resource.data.text == resource.data.text
          && request.resource.data.seen == true)
      );
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    /* КОНТАКТЫ (заявка → принятие). Документ на ПАРУ, id = отсортированные uid через
       "__", поэтому повторная заявка не плодит дубли. Видят только двое; принять может
       ТОЛЬКО адресат (status "pending" → "ok"); удалить (отклонить заявку или убрать из
       контактов) — любая из сторон. */
    match /chat_contacts/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if (isApproved() || isAdmin()) && !chatBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.uids is list
        && request.resource.data.uids.size() == 2
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.to in request.resource.data.uids
        && request.resource.data.status == "pending";
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.uids == resource.data.uids
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status == "ok";
      allow delete: if signedIn() && request.auth.uid in resource.data.uids;
    }

    /* ВЛОЖЕНИЯ чата (проект квартиры, позиция БД, предварительная смета): тело лежит
       ОТДЕЛЬНЫМ документом, в сообщении — только ссылка. Так сообщение остаётся
       маленьким, а тяжёлое тело читается ТОЛЬКО когда получатель нажал «применить».
       pub:true — вложение из ОБЩЕГО чата (его и так видят все одобренные), иначе видят
       лишь участники лички (uids). Менять нельзя вообще: вложение — снимок. */
    match /chat_files/{fileId} {
      allow read: if isAdmin()
        || (resource.data.pub == true && (isApproved() || isAdmin()))
        || (signedIn() && request.auth.uid in resource.data.uids);
      allow create: if (isApproved() || isAdmin()) && !chatBanned()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 900000;
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }

    /* ГРУППОВЫЕ ЧАТЫ (по объекту/бригаде). Комната — список участников; сообщение
       НЕСЁТ СВОЙ СНИМОК uids, поэтому правило проверяет доступ БЕЗ get() комнаты на
       каждое чтение (дешевле и не ломается, если комнату переименовали/удалили).
       Следствие, раскрытое пользователю: добавленный позже участник видит переписку
       С МОМЕНТА ДОБАВЛЕНИЯ — старые сообщения несут прежний список uids. */
    match /chat_rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if (isApproved() || isAdmin()) && !chatBanned()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.uids is list
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() <= 50
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && request.auth.uid in resource.data.uids
        && request.resource.data.by == resource.data.by
        && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 50
        && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin() || (signedIn() && resource.data.by == request.auth.uid);
    }
    match /chat_group/{msgId} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if (isApproved() || isAdmin()) && !chatBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.uids is list
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.roomId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.ts is number;
      allow update: if signedIn()
        && resource.data.from == request.auth.uid
        && request.resource.data.from == resource.data.from
        && request.resource.data.ts == resource.data.ts
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
    }

    /* PUSH-ТОКЕНЫ устройств (FCM) — чтобы уведомление о сообщении приходило, когда
       приложение ПОЛНОСТЬЮ закрыто. id документа = сам токен, поэтому повторный вход с
       того же устройства не плодит дубли. КЛИЕНТ НЕ ЧИТАЕТ эту коллекцию вообще
       (`allow read: if false`) — по токенам и uid можно было бы составить список
       устройств чужих людей; читает только Cloud Function через admin SDK, который
       правила не проверяет. Писать — только свой токен (uid == свой), удалять — свой
       (выход из аккаунта) или админ (чистка). Обязателен `uid`, иначе функция не
       поймёт, кому принадлежит токен. */
    match /chat_tokens/{token} {
      allow read: if false;
      allow create, update: if (isApproved() || isAdmin())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
